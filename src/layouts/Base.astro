---
import '../styles/global.css';
import { SITE, bookCall } from '../data';
import { posts } from '../posts';

interface Props {
  title: string;
  description: string;
  type?: 'website' | 'article';
  jsonld?: object;
  /** Absolute URL of this page's share image; the site default otherwise. */
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
}
const { title, description, type = 'website', jsonld, image, imageAlt, noindex = false } = Astro.props;
const ogImage = image ?? new URL('/og.jpg', Astro.site).href;
const ogAlt = image ? (imageAlt ?? title) : 'A hooded hacker above the word HACKERMAN';
// build.format 'file' makes the build-time path end in .html; the served URL doesn't.
const path = Astro.url.pathname.replace(/(index)?\.html$/, '');
const canonical = new URL(path, Astro.site).href;
const fullTitle = path === '/' ? title : `${title} — ${SITE.name}`;
// Writing stays out of the nav until there's a post to read.
const hasWriting = (await posts()).length > 0;
const nav = [
  ['/work', 'Work'],
  ...(hasWriting ? [['/writing', 'Writing']] : []),
  ['https://essays.umarkhatana.com/', 'Essays'],
  ['/about', 'About'],
];
const current = (href: string) => path.startsWith(href);
// The game is only linked once its agent is deployed and the build knows where it is.
const agentLive = Boolean(import.meta.env.PUBLIC_AGENT_URL);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <meta name="author" content={SITE.name} />
  {noindex && <meta name="robots" content="noindex, follow" />}
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <meta property="og:type" content={type} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:alt" content={ogAlt} />
  <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="twitter:image:alt" content={ogAlt} />
  {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
</head>
<body>
  <header class="site-header wrap">
    <a class="site-name" href="/">{SITE.name}</a>
    <nav aria-label="Main">
      {nav.map(([href, label]) => <a href={href} aria-current={current(href) ? 'page' : undefined}>{label}</a>)}
      {agentLive && <a class="nav-cta" href="/agent" aria-current={current('/agent') ? 'page' : undefined}>Rob my agent</a>}
    </nav>
  </header>
  <main class="wrap">
    <slot />
  </main>
  <footer class="site-footer wrap">
    <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
    <a href={bookCall('footer')}>Book a call</a>
    <a href={SITE.github}>GitHub</a>
    <a href={SITE.linkedin}>LinkedIn</a>
    <a href="/rss.xml">RSS</a>
  </footer>
</body>
</html>
