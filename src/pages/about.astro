---
import Base from '../layouts/Base.astro';
import Quote from '../components/Quote.astro';
import { SITE, bookCall, about, services, plainServices, roles, quotes, skills, education, certifications, person } from '../data';
---
<Base title="About" description={`${SITE.name}, ${SITE.jobTitle}. Background, experience and how to get in touch.`} jsonld={person}>
  <h1>About</h1>
  {about.map((p) => <p>{p}</p>)}

  <h2>Automation for your business</h2>
  <p>If you run a business rather than build software, this is what I can take off your plate. <a href={SITE.planTool}>Get a free automation plan</a> for your own case, or <a href={bookCall('about')}>book a call</a>.</p>
  {plainServices.map((s) => <>
    <h3>{s.heading}</h3>
    <p>{s.body}</p>
  </>)}

  <h2>What I build</h2>
  {services.map((s) => <>
    <h3>{s.heading}</h3>
    <ul>{s.items.map((i) => <li>{i}</li>)}</ul>
  </>)}

  <h2>Experience</h2>
  <ul class="list">
    {roles.map((r) => (
      <li>
        <span class="title">{r.role}, {r.company}</span>
        <span class="meta">{r.dates}</span>
        <p>{r.line}</p>
      </li>
    ))}
  </ul>

  <h2>What people say</h2>
  {quotes.about.map((q) => <Quote q={q} />)}

  <h2>Tools</h2>
  <p>{skills.join(' · ')}</p>

  <h2>Contact</h2>
  <p>
    Email <a href={`mailto:${SITE.email}`}>{SITE.email}</a>, <a href={bookCall('about')}>book a 30-minute call</a>,
    or find me on <a href={SITE.github}>GitHub</a> and <a href={SITE.linkedin}>LinkedIn</a>.
  </p>

  <h2>Education, awards &amp; certifications</h2>
  <ul class="plain">
    {[...education, ...certifications].map((e) => <li class="meta">{e}</li>)}
  </ul>
</Base>
