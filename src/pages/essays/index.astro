---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { posts } from '../../posts';

const items = (await posts('essays')).map((p) => ({ section: 'essays' as const, p }));
---
<Base title="Essays" description="Essays on history, ideas and anything else that doesn't fit under engineering.">
  <h1>Essays</h1>
  <p class="lede">Longer pieces on history, ideas and everything that isn't code.</p>
  <PostList items={items} />
</Base>
