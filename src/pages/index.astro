---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Quote from '../components/Quote.astro';
import { SITE, bookCall, intro, quotes, person, website } from '../data';
import { projects } from '../work';
import { posts } from '../posts';

const recent = (await posts()).slice(0, 3);
const featured = (await projects()).filter((p) => p.data.featured).slice(0, 3);
---
<Base title={`${SITE.name} — ${SITE.jobTitle}`} description={SITE.tagline} jsonld={{ '@context': 'https://schema.org', '@graph': [person, website] }}>
  <h1>{SITE.name}</h1>
  <p class="lede">{SITE.tagline}</p>
  {intro.map((p) => <p>{p}</p>)}
  <p class="meta">Live now: <a href="https://nobodysplaying.umarkhatana.com">Agentistan</a>, a war two AI generals fight on their own, run by n8n, Chainlink and a blockchain. Watch it.</p>

  {recent.length > 0 && <>
    <h2>Recent writing</h2>
    <PostList items={recent} />
  </>}

  <h2>Selected work</h2>
  <div class="wide project-grid three">
    {featured.map((p, i) => <ProjectCard project={p} eager={i === 0} />)}
  </div>
  <p class="more"><a href="/work">See all work →</a></p>

  <Quote q={quotes.home} />

  <p class="callout">Run a clinic, practice, firm or small business? <a href={SITE.planTool}>Get a free automation plan for your business</a> — describe what you do and an AI drafts a 2–3 step plan in a minute.</p>

  <p>Building something? Email <a href={`mailto:${SITE.email}`}>{SITE.email}</a> or <a href={bookCall('home')}>book a 30-minute call</a>.</p>
</Base>
