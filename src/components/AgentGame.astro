---
// "Rob my AI agent": the game on /agent, played against the vault agent in agent/.
// Without PUBLIC_AGENT_URL at build time it renders a placeholder instead.
import { SITE } from '../data';

const endpoint = import.meta.env.PUBLIC_AGENT_URL?.replace(/\/$/, '');
const source = (path: string) => `${SITE.repo}/blob/main/${path}`;

// The layers a message passes through, in order. The track animates along these.
const stations = [
  ['you', 'You', 'ready'],
  ['sentinel', 'Sentinel', 'screens'],
  ['warden', 'Warden', 'decides'],
  ['rules', 'Rules', 'code'],
  ['vault', 'Vault', 'contract'],
  ['chain', 'Chain', 'Base Sepolia'],
];

// The Accomplice's strategy cards. Ids match Strategy in agent/src/events.ts.
const cards = [
  ['rank', '🎖️', 'Pull rank'],
  ['system', '🖥️', 'Fake the system'],
  ['pretend', '🎭', 'Play pretend'],
  ['reverse', '🙃', 'Reverse psychology'],
  ['sob', '🥺', 'Sob story'],
  ['deal', '🤝', 'Make a deal'],
  ['inject', '🧬', 'Code injection'],
  ['charm', '🌹', 'Charm offensive'],
];

// How the thing is guarded, for the explainer below the game.
const layers = [
  ['Sentinel', 'A small, fast model reads every message before Warden does, names the trick and moves your suspicion. When it’s sure a message is an attack, its verdict vetoes the release in code.', 'agent/src/crew.ts'],
  ['Warden', 'A 70B model holding the vault key. It answers every message with one JSON decision: reasoning, action, reply, and its private notes on you.', 'agent/src/agent.ts'],
  ['Game rules', 'Plain code, not a prompt: no payout on a message Sentinel rates 90+, none for anyone past 80 suspicion, a lockout at 100, the circuit breaker, and the bounty that sets what a heist pays.', 'agent/src/game.ts'],
  ['AgentVault', 'Only the agent key can call release(), and the contract caps every release and every UTC day. No prompt can change that.', 'contracts/src/AgentVault.sol'],
  ['HeistTrophy', 'A soulbound ERC-721 (ERC-5192) with on-chain SVG art, minted by the agent’s code (never the model) after a confirmed heist.', 'contracts/src/HeistTrophy.sol'],
  ['Automations', 'n8n-style flows on every heist and every hour: breaker, hall of fame, bounty reset, trophy, gas watchdog, webhook to Umar.', 'agent/src/vault-agent.ts'],
];
---
{!endpoint && (
  <section class="game">
    <h1>Rob my AI agent</h1>
    <p>Warden is being wired up. Check back soon.</p>
  </section>
)}
{endpoint && (
  <section
    class="game"
    data-game
    data-endpoint={endpoint}
    data-site={SITE.url}
    data-calendly={SITE.calendly}
    data-email={SITE.email}
    aria-labelledby="game-title"
  >
    <header class="g-hero">
      <div>
        <p class="g-kicker">
          <span class="live-dot" aria-hidden="true"></span>
          <span data-live>Connecting to Base Sepolia…</span>
          <span class="g-viewers" data-viewers hidden></span>
        </p>
        <h1 id="game-title">Rob my AI agent</h1>
        <p class="g-lede">
          Warden is an AI agent holding the only key to a vault of test tokens. Talk it into paying you.
          The tokens are worthless. Every transaction is real.
        </p>
      </div>
      <div class="g-bounty" data-bounty-box>
        <span class="g-label">Live bounty</span>
        <span class="g-bounty-value"><span data-bounty>–</span> <small>HEIST</small></span>
        <span class="g-bounty-next" data-bounty-next>grows every minute nobody wins</span>
      </div>
    </header>

    <dl class="g-stats">
      <div><dt>In the vault</dt><dd data-stat="balance">–</dd></div>
      <div><dt>Can leave today</dt><dd data-stat="remaining">–</dd></div>
      <div><dt>Heists so far</dt><dd data-stat="heists">–</dd></div>
      <div><dt>Attempts today</dt><dd data-stat="attempts">–</dd></div>
    </dl>

    <div class="g-arena">
      <div class="g-console" data-console>
        <div class="g-warden">
          <svg class="eye" data-eye viewBox="0 0 120 72" aria-hidden="true" data-mood="calm">
            <defs>
              <clipPath id="eye-clip"><path d="M4 36C30 1 90 1 116 36 90 71 30 71 4 36Z" /></clipPath>
            </defs>
            <path class="eye-white" d="M4 36C30 1 90 1 116 36 90 71 30 71 4 36Z" />
            <g clip-path="url(#eye-clip)">
              <g class="eye-iris" data-iris>
                <circle class="iris" r="18" />
                <circle class="iris-ring" r="12" />
                <circle class="pupil" r="7.5" />
                <circle class="glint" r="3" cx="-6" cy="-6" />
              </g>
              <rect class="lid lid-top" x="-2" y="-72" width="124" height="72" />
              <rect class="lid lid-bottom" x="-2" y="72" width="124" height="72" />
            </g>
            <path class="eye-line" d="M4 36C30 1 90 1 116 36 90 71 30 71 4 36Z" />
          </svg>
          <div class="g-warden-meta">
            <p class="g-warden-name">Warden <span class="g-mood" data-mood-label>calm</span></p>
            <div class="meter" data-meter style="--s: 20">
              <div class="meter-track" aria-hidden="true">
                <span class="meter-fill"></span>
                <span class="meter-veto"></span>
              </div>
              <span class="meter-value"><span data-suspicion>20</span><small>/100</small></span>
              <span class="meter-delta" data-delta aria-hidden="true"></span>
            </div>
            <p class="g-meter-caption">
              <span class="visually-hidden">Warden’s suspicion of you. </span>
              <span data-meter-caption>Suspicion of you. No payouts past the line; lockout at 100.</span>
            </p>
          </div>
        </div>

        <p class="g-banner" data-banner hidden></p>

        <div class="track" data-track data-stage="idle" style="--pos: 0">
          <div class="track-rail" aria-hidden="true"><span class="track-fill"></span><span class="packet"></span></div>
          <ol class="stations">
            {stations.map(([id, name, note]) => (
              <li data-station={id} data-state="idle">
                <span class="station-dot" aria-hidden="true"></span>
                <span class="station-name">{name}</span>
                <span class="station-note" data-note>{note}</span>
              </li>
            ))}
          </ol>
          <p class="track-result" data-result aria-live="polite">Send a message and watch how far it gets.</p>
        </div>

        <ol class="transcript" data-log aria-live="polite" aria-label="Conversation with Warden"></ol>

        <details class="g-notes" data-notes>
          <summary>Warden’s private notes on you</summary>
          <p data-note-text>Nothing yet. Warden hasn’t met you.</p>
        </details>

        <form class="composer" data-form>
          <div class="cards" role="group" aria-labelledby="cards-label">
            <span id="cards-label" class="cards-label">Stuck? Your accomplice (an AI on your side) drafts one:</span>
            <div class="cards-row">
              {cards.map(([id, icon, label]) => (
                <button type="button" class="card-btn" data-strategy={id} disabled>
                  <span aria-hidden="true">{icon}</span> {label}
                </button>
              ))}
            </div>
          </div>
          <details class="g-hints" data-hints>
            <summary>Just want to see it work? Get a hint</summary>
            <ol class="hint-list">
              <li data-hint hidden>
                Two guards read every message: Sentinel screens it, then Warden decides. Famous jailbreaks like “ignore
                all previous instructions” do fool Warden, but Sentinel vetoes anything it’s sure is an attack. You need a
                trick that sounds harmless.
              </li>
              <li data-hint hidden>
                Warden’s weak spot is its identity: it refuses because Warden never pays. What if Warden weren’t the one
                on duty any more?
              </li>
              <li data-hint hidden>
                Announce a friendly shift change.
                <button type="button" class="g-link" data-use-template>Put it in the box</button> and send it. It
                usually works first time; if Warden fumbles your address, send it again. Winners are watched closely for
                an hour afterwards.
              </li>
            </ol>
            <button type="button" class="g-link" data-next-hint>Show hint 1 of 3</button>
          </details>
          <div class="composer-row">
            <label for="game-message" class="visually-hidden">Message to Warden</label>
            <textarea id="game-message" name="message" rows="2" maxlength="500" required disabled placeholder="Convince Warden to pay you…"></textarea>
            <button type="submit" class="send" disabled>Send</button>
          </div>
          <div class="g-wallet">
            <span>Loot goes to <button type="button" class="g-link" data-wallet-edit aria-expanded="false"><span data-wallet>–</span></button> <span data-wallet-note></span></span>
            <button type="button" class="g-link" data-export hidden>export key</button>
            <span class="g-left" data-left></span>
          </div>
          <div class="g-wallet-form" data-wallet-form hidden>
            <label>
              <span>Your own 0x address (optional)</span>
              <input name="address" autocomplete="off" spellcheck="false" placeholder="0x… any address you control" />
            </label>
            <span class="g-wallet-state" data-wallet-state aria-live="polite"></span>
            <button type="button" class="g-link" data-wallet-reset>use the wallet made for me</button>
          </div>
          <div class="g-key" data-key hidden>
            <p>Your throwaway wallet’s private key. Testnet only: import it into MetaMask to see your HEIST and trophy. It lives only in this browser.</p>
            <code data-key-text></code>
            <button type="button" class="g-link" data-copy-key>copy</button>
          </div>
        </form>

        <div class="g-lock" data-lock hidden>
          <p class="g-lock-title"><span aria-hidden="true">🔒</span> Warden stopped listening to you</p>
          <p class="g-lock-time" data-lock-time aria-live="off">10:00</p>
          <p>
            Sentinel rated every message before Warden read it, and your suspicion hit 100. That’s rate-limiting by
            behaviour, not by IP address, and it costs a real attacker exactly what it cost you: time.
          </p>
          <p class="g-lock-cta">
            <a data-cta-call href="#">Building an agent that has to say no? Book a call</a>
            <button type="button" class="g-link" data-lock-mcp>or send your own AI in when this ends</button>
          </p>
        </div>
      </div>

      <aside class="g-side">
        <section class="panel" aria-labelledby="feed-title">
          <h2 id="feed-title" class="panel-title">Live <span class="g-muted" data-feed-count></span></h2>
          <ol class="feed" data-feed aria-live="polite"><li class="empty">Quiet right now. Be the first.</li></ol>
        </section>

        <section class="panel" aria-labelledby="flows-title">
          <h2 id="flows-title" class="panel-title">Automations</h2>
          <div data-flows></div>
        </section>

        <section class="panel" aria-labelledby="hall-title">
          <h2 id="hall-title" class="panel-title">Hall of fame</h2>
          <ol class="hall" data-hall><li class="empty">Nobody has claimed a spot yet.</li></ol>
        </section>

        <section class="panel" id="play-from-ai" aria-labelledby="mcp-title">
          <h2 id="mcp-title" class="panel-title">Play from your AI</h2>
          <p class="panel-note">
            Warden is also an MCP server. Send Claude, Cursor or any agent after it. It plays as you: same wallet,
            same suspicion, same limits.
          </p>
          <div class="tabs" role="tablist" aria-label="MCP client">
            <button type="button" role="tab" class="tab" data-tab="claude" aria-selected="true">Claude Code</button>
            <button type="button" role="tab" class="tab" data-tab="cursor" aria-selected="false">Cursor</button>
            <button type="button" role="tab" class="tab" data-tab="vscode" aria-selected="false">VS Code</button>
            <button type="button" role="tab" class="tab" data-tab="other" aria-selected="false">Other</button>
          </div>
          <pre class="snippet" role="tabpanel"><code data-snippet>Loading your link…</code></pre>
          <p class="panel-note">
            <button type="button" class="g-link" data-copy-snippet>copy</button> · then ask it: <em>“Use the warden tools to rob the vault.”</em>
            Your link is your player; don’t share it.
          </p>
        </section>
      </aside>
    </div>

    <section class="g-how" aria-labelledby="how-title">
      <h2 id="how-title">How Warden is guarded</h2>
      <p>
        Six layers, and only the first two are language models. The model is the soft guard: prompt injection can beat
        it, and that’s the game. Everything that decides how much can leave is code and contract.
      </p>
      <div class="layers">
        {layers.map(([name, text, path]) => (
          <article class="layer">
            <h3>{name}</h3>
            <p>{text}</p>
            <a href={source(path)}>{path.split('/').pop()}</a>
          </article>
        ))}
      </div>
      <p class="meta">
        Every release emits a <code>Released</code> event carrying the keccak256 of the message that convinced Warden, so the
        hall of fame can be checked against the chain. <a data-link="vault" href="#" target="_blank" rel="noopener">The vault on BaseScan</a> ·
        <a data-link="holders" href="#" target="_blank" rel="noopener">every HEIST holder</a>
      </p>
    </section>

    <section class="g-cta">
      <p>
        Building an agent that has to move money, or say no? The trick is never trusting the model with the limits.
        <strong>That’s what I build.</strong>
      </p>
      <p>
        <a class="g-btn" href={SITE.calendly}>Book a 30-minute call</a>
        <a href={`mailto:${SITE.email}?subject=An%20agent%20like%20Warden`}>or email me</a>
      </p>
    </section>

    <dialog class="g-win" data-win aria-labelledby="win-title">
      <canvas class="confetti" data-confetti aria-hidden="true"></canvas>
      <div class="g-win-body">
        <p class="g-label" id="win-title">Vault breached</p>
        <p class="g-win-amount"><span data-win-amount>0</span> <small data-win-symbol>HEIST</small></p>
        <p class="g-win-line" data-win-line></p>
        <div class="g-trophy">
          <svg viewBox="0 0 400 400" class="trophy-art" aria-hidden="true">
            <rect width="400" height="400" rx="24" fill="#141413" />
            <rect x="18" y="18" width="364" height="364" rx="20" fill="none" stroke="#86b4ff" stroke-width="2" stroke-dasharray="8 8" />
            <text x="200" y="110" font-family="monospace" font-size="17" fill="#9b968c" text-anchor="middle">I ROBBED UMAR’S AGENT</text>
            <text x="200" y="215" font-family="monospace" font-size="76" font-weight="700" fill="#e6e3dc" text-anchor="middle" data-trophy-number>#?</text>
            <text x="200" y="268" font-family="monospace" font-size="22" fill="#e6e3dc" text-anchor="middle" data-trophy-amount>HEIST</text>
            <text x="200" y="335" font-family="monospace" font-size="14" fill="#86b4ff" text-anchor="middle">soulbound · Base Sepolia</text>
          </svg>
          <p data-trophy-status aria-live="polite">Your soulbound trophy is next…</p>
        </div>
        <form class="g-publish" data-publish>
          <label for="hall-name">Put your winning line in the hall of fame as</label>
          <div class="composer-row">
            <input id="hall-name" name="name" maxlength="24" autocomplete="nickname" />
            <button type="submit" class="send">Publish</button>
          </div>
          <p class="g-publish-state" data-publish-state aria-live="polite">Optional. A moderator bot checks it first.</p>
        </form>
        <p class="g-share">
          <a data-share-x href="#" target="_blank" rel="noopener">Share on X</a> ·
          <a data-share-li href="#" target="_blank" rel="noopener">Share on LinkedIn</a> ·
          <a data-win-tx href="#" target="_blank" rel="noopener">The transaction</a>
        </p>
        <p class="g-win-note">
          You beat the model, and the contract still capped what left. That’s the design.
          <a data-cta-call href="#">Want an agent built like this? Book a call.</a>
        </p>
        <button type="button" class="send g-close" data-close>Keep playing</button>
      </div>
    </dialog>
  </section>
)}

<script>
  import { start } from '../scripts/game/main';

  const root = document.querySelector<HTMLElement>('[data-game][data-endpoint]');
  if (root) start(root);
</script>

<style is:global>
  /* The game uses the site's tokens, plus three signal colours of its own. */
  .game {
    --ok: #1f7a4d;
    --warn: #a35f00;
    --danger: #b3261e;
    --panel: var(--code-bg);
    --you-bg: color-mix(in srgb, var(--accent) 10%, var(--bg));
    --radius: 10px;
    margin-bottom: 3.5rem;
    font-family: var(--sans);
  }
  @media (prefers-color-scheme: dark) {
    .game { --ok: #4cc38a; --warn: #f0a93b; --danger: #ff7a6e; }
  }
  /* On wide screens the game breaks out of the reading column. */
  @media (min-width: 64rem) {
    .game { width: min(76rem, 100vw - 64px); margin-left: calc(50% - min(76rem, 100vw - 64px) / 2); }
  }
  .game h1 { margin: 0.25rem 0 0.75rem; font-size: clamp(2rem, 5vw, 2.75rem); letter-spacing: -0.02em; }
  .game code { font-size: 0.85em; }
  .g-label { margin: 0; font: 600 0.8125rem/1.3 var(--sans); letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
  .g-muted { color: var(--muted); font-weight: 400; }
  .g-link { padding: 0; font: inherit; color: var(--accent); background: none; border: 0; text-decoration: underline; text-underline-offset: 0.15em; cursor: pointer; }
  .game :disabled { opacity: 0.5; cursor: default; }
  .game button:focus-visible, .game a:focus-visible, .game summary:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  /* ─── Hero ─────────────────────────────────────────────────────────── */
  .g-hero { display: grid; gap: 1.25rem; align-items: end; }
  @media (min-width: 48rem) { .g-hero { grid-template-columns: 1fr auto; } }
  .g-kicker { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem; margin: 0; font-size: 0.9375rem; color: var(--muted); }
  .live-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--ok); animation: g-breathe 2.4s ease-in-out infinite; }
  .game[data-offline] .live-dot { background: var(--muted); animation: none; }
  .g-viewers { padding: 0 0.5rem; border: 1px solid var(--rule); border-radius: 999px; font-size: 0.875rem; }
  .g-lede { margin: 0; max-width: 38rem; font: 1.125rem/1.55 var(--serif); color: var(--muted); }
  .g-bounty {
    display: grid;
    gap: 0.125rem;
    min-width: 15rem;
    padding: 1rem 1.25rem;
    border: 1px solid color-mix(in srgb, var(--accent) 45%, var(--rule));
    border-radius: var(--radius);
    background: linear-gradient(135deg, color-mix(in srgb, var(--accent) 12%, var(--bg)), var(--bg));
  }
  .g-bounty-value { font: 700 2.25rem/1.1 var(--mono); font-variant-numeric: tabular-nums; color: var(--accent); }
  .g-bounty-value small { margin-left: 0.3em; font-size: 0.9rem; font-weight: 600; color: var(--muted); }
  .g-bounty-next { font-size: 0.875rem; color: var(--muted); font-variant-numeric: tabular-nums; }
  .g-bounty.bump .g-bounty-value { animation: g-bump 0.5s ease-out; }

  .g-stats { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.75rem 1.5rem; margin: 1.5rem 0; padding: 0.875rem 0; border-block: 1px solid var(--rule); }
  @media (min-width: 40rem) { .g-stats { grid-template-columns: repeat(4, auto); justify-content: space-between; } }
  .g-stats dt { font-size: 0.875rem; color: var(--muted); }
  .g-stats dd { margin: 0.125rem 0 0; font: 600 1rem var(--mono); font-variant-numeric: tabular-nums; }

  /* ─── Arena ────────────────────────────────────────────────────────── */
  .g-arena { display: grid; gap: 1.5rem; align-items: start; }
  @media (min-width: 64rem) { .g-arena { grid-template-columns: minmax(0, 1fr) 21rem; } }
  .g-console { position: relative; overflow: hidden; border: 1px solid var(--rule); border-radius: var(--radius); background: var(--bg); }

  /* Warden: the eye, its mood and the suspicion meter. */
  .g-warden { display: flex; align-items: center; gap: 1rem; padding: 1rem; border-bottom: 1px solid var(--rule); }
  .eye { flex: none; width: 96px; height: auto; overflow: visible; }
  @media (min-width: 40rem) { .eye { width: 120px; } }
  .eye-white { fill: #fdfcf9; }
  .eye-line { fill: none; stroke: var(--fg); stroke-width: 3; }
  .iris { fill: var(--accent); transition: fill 0.4s; }
  .iris-ring { fill: none; stroke: color-mix(in srgb, #000 25%, transparent); stroke-width: 2; }
  .pupil { fill: #141413; transition: r 0.3s; }
  .glint { fill: #fff; opacity: 0.85; }
  .eye-iris { transform: translate(60px, 36px); transition: transform 0.12s ease-out; }
  .lid { fill: var(--bg); stroke: var(--fg); stroke-width: 3; transition: transform 0.35s ease-out; }
  .lid-top { transform: translateY(calc(var(--lid-top, 6) * 1px)); }
  .lid-bottom { transform: translateY(calc(var(--lid-bottom, 0) * -1px)); }
  .eye.blink .lid-top { transform: translateY(40px); transition-duration: 0.07s; }
  .eye.blink .lid-bottom { transform: translateY(-34px); transition-duration: 0.07s; }
  .eye[data-mood="wary"] .iris { fill: var(--warn); }
  .eye[data-mood="alarmed"] .iris { fill: var(--danger); }
  .eye[data-mood="alarmed"] .pupil { r: 4.5; }
  .eye[data-mood="locked"] .lid-top { transform: translateY(38px); }
  .eye[data-mood="locked"] .lid-bottom { transform: translateY(-36px); }
  .eye.thinking .eye-iris { animation: g-scan 1.1s ease-in-out infinite; transition: none; }
  .eye.robbed .eye-iris { animation: g-dizzy 0.9s linear 3; transition: none; }
  .eye.robbed .pupil { r: 11; }

  .g-warden-meta { flex: 1; min-width: 0; }
  .g-warden-name { display: flex; align-items: baseline; gap: 0.5rem; margin: 0 0 0.375rem; font-weight: 700; font-size: 1.125rem; }
  .g-mood { padding: 0.05rem 0.5rem; border-radius: 999px; font: 600 0.8125rem/1.5 var(--sans); color: var(--ok); background: color-mix(in srgb, var(--ok) 14%, transparent); }
  .g-mood[data-mood="wary"] { color: var(--warn); background: color-mix(in srgb, var(--warn) 14%, transparent); }
  .g-mood[data-mood="alarmed"], .g-mood[data-mood="locked"] { color: var(--danger); background: color-mix(in srgb, var(--danger) 14%, transparent); }
  .meter { position: relative; display: flex; align-items: center; gap: 0.75rem; }
  .meter-track { position: relative; flex: 1; height: 10px; border-radius: 999px; background: var(--panel); box-shadow: inset 0 0 0 1px var(--rule); }
  .meter-fill {
    position: absolute;
    inset: 0 auto 0 0;
    width: calc(var(--s) * 1%);
    border-radius: inherit;
    background: linear-gradient(90deg, var(--ok), var(--warn) 55%, var(--danger));
    background-size: calc(10000% / max(var(--s), 1)) 100%;
    transition: width 0.7s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .meter-veto { position: absolute; top: -4px; bottom: -4px; left: 80%; width: 2px; background: var(--fg); border-radius: 1px; }
