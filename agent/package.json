    "dev-llm": "tsx scripts/dev-llm.ts"
  },
  "dependencies": {
    "viem": "^2.56.9"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "wrangler": "^4.140.0"
  }
}
