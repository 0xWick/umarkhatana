# Copy to .dev.vars for `npm run dev`. Never commit the real file.
AGENT_PRIVATE_KEY=0x...
# Optional OpenAI-compatible fallback for when the Workers AI free allowance runs out.
# FALLBACK_LLM_URL=https://api.groq.com/openai/v1
# FALLBACK_LLM_KEY=...
# FALLBACK_LLM_MODEL=llama-3.3-70b-versatile
# Offline instead: `npm run dev-llm` and `wrangler dev --local`, with
# FALLBACK_LLM_URL=http://127.0.0.1:11435/v1 FALLBACK_LLM_KEY=dev FALLBACK_LLM_MODEL=dev
# Optional: n8n / Slack / Discord webhook for heists and gas alerts.
# NOTIFY_WEBHOOK_URL=https://...
# Optional: lets DELETE /hall?tx=… hide a hall-of-fame entry.
# ADMIN_TOKEN=...
